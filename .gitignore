# secrets / tokens - never commit
.env.local
.env.*.local
tokens.env
*.jwt
*.token

# local Python env
.venv/
__pycache__/
*.pyc

# generated test artifacts (docs/*.gif is intentionally tracked, not ignored)
test-screenshots/
test-results/
*.webm

# local k8s/kubeconfig artifacts, if ever dumped here
kubeconfig*
